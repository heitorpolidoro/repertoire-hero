# Repertoire Hero — environment template.
#
#   cp .env.example .env         # Docker Compose reads .env in EVERY subcommand
#   cp .env.example .env.local   # the host-side tooling reads .env.local
#
# Neither .env nor .env.local is tracked; this template is. No value here is a real
# credential: every secret slot ships empty on purpose.

# ---- Compose mode ---------------------------------------------------------
# Which profile `docker compose` activates (see docker-compose.yml).
#   standalone   this repo starts its own Postgres (see POSTGRES_PORT below)
#   poli-runner  injected by poli-runner; the bundled postgres stays down and
#                POSTGRES_URL comes from the runner (see poli-runner.yml)
COMPOSE_PROFILES=standalone

# Where the `app` container connects, in standalone mode. `postgres` is the
# compose-network hostname of the bundled service and 5432 its in-container port.
# This is compose-only territory: the host-side tooling reads DATABASE_URL below
# from .env.local instead, and never reads .env.
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Host port the bundled Postgres publishes. 54322 is the repository default —
# vitest.config.ts falls back to it and AGENTS.md documents it. Override it only
# if the port is already taken on your machine.
POSTGRES_PORT=54322

# Superuser password for the bundled Postgres. Local-only placeholder.
POSTGRES_PASSWORD=postgres

# Test setup — opt in to the database-backed vitest suites (needs a live Postgres
# at DATABASE_URL with the migrations applied). Uncomment it in your own
# .env.local to run them. It ships commented out on purpose: `cp .env.example
# .env.local` must leave the variable genuinely unset, because a bare
# `RUN_DB_TESTS=` line would set it to the empty string.
# RUN_DB_TESTS=1

# Development convenience: set to "true" to skip the login page and auto-sign in
# Never enable in production.
NEXT_PUBLIC_AUTO_LOGIN=false
NEXT_PUBLIC_DEV_USER_EMAIL=you@example.com
NEXT_PUBLIC_DEV_USER_PASSWORD=devpassword

# Sentry — https://sentry.io/settings/<org>/projects/<project>/keys/
# NEXT_PUBLIC_SENTRY_DSN is embedded in the client bundle; SENTRY_DSN is server-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Spotify — https://developer.spotify.com/dashboard
# Used for the "From Spotify" search feature (optional — omit to disable).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# OAuth redirect URI — use the production URL when deploying to Vercel.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Better Auth — https://better-auth.com
# Use 'openssl rand -base64 32' to generate a secure secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Email Service (Resend) — https://resend.com
# Required for password recovery in production (optional locally, falls back to logging).
RESEND_API_KEY=
EMAIL_FROM="Repertoire Hero <noreply@yourdomain.com>"
