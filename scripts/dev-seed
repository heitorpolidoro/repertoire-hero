#!/usr/bin/env bash
# =============================================================================
# scripts/dev-seed
#
# Resets and seeds the local development database with a clean set of users.
#
# Inserts Better Auth user + account rows and matching profiles directly via
# psql — no running dev server required.
#
# Usage:
#   bash scripts/dev-seed [DATABASE_URL]
#
# Default DATABASE_URL: postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   (the bundled compose Postgres — override the port with the argument when
#    POSTGRES_PORT is set to something other than 54322)
# Password for all dev users: password
# =============================================================================

set -euo pipefail

DB_URL="${1:-${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}}"

# Hash of "password" generated by @better-auth/utils hashPassword (scrypt).
# To regenerate: node --input-type=module -e "
#   import { hashPassword } from './node_modules/@better-auth/utils/dist/password.mjs';
#   console.log(await hashPassword('password'));
# "
PASSWORD_HASH="833c3aea9353e3ea3c6a0fec1eee721c:372df83d18e5b0f95107817d5c2e3e0191c4fbf5b69b9bd9f3b24f0c2ca6d629907f098fea0d3fe5245b7a81c298b1c177be80e4eeae75c8d3dd658eb8ab992f"

echo "🌱 Seeding dev database ($DB_URL)..."
echo ""

psql "$DB_URL" <<SQL

-- ── Clean slate ─────────────────────────────────────────────────────────────
DELETE FROM bands;        -- cascades to band_members, band_songs, playlists
DELETE FROM "user";       -- cascades to account, session, profiles -> user_songs
DELETE FROM songs;        -- no FK owner; must be cleaned separately

-- ── Users (Better Auth) ─────────────────────────────────────────────────────
INSERT INTO "user" (id, email, name, "emailVerified", "createdAt", "updatedAt")
VALUES
  (gen_random_uuid(), 'com.spotify@exemple.com', 'Com Spotify', true, now(), now()),
  (gen_random_uuid(), 'sem_spotify@exemple.com', 'Sem Spotify', true, now(), now()),
  (gen_random_uuid(), 'sem_banda@exemple.com',   'Sem Banda',   true, now(), now());

-- ── Credentials ─────────────────────────────────────────────────────────────
INSERT INTO "account" (id, "accountId", "providerId", "userId", password, "createdAt", "updatedAt")
SELECT gen_random_uuid(), u.email, 'credential', u.id, '$PASSWORD_HASH', now(), now()
FROM "user" u;

-- ── Profiles ─────────────────────────────────────────────────────────────────
INSERT INTO profiles (id, email, full_name, instruments, primary_instrument)
SELECT
  u.id,
  u.email,
  u.name,
  CASE u.email
    WHEN 'com.spotify@exemple.com' THEN ARRAY['Bass Guitar', 'Backing Vocals']
    WHEN 'sem_spotify@exemple.com' THEN ARRAY['Drums', 'Guitar']
    WHEN 'sem_banda@exemple.com'   THEN ARRAY['Piano', 'Saxophone']
  END,
  CASE u.email
    WHEN 'com.spotify@exemple.com' THEN 'Bass Guitar'
    WHEN 'sem_spotify@exemple.com' THEN 'Drums'
    WHEN 'sem_banda@exemple.com'   THEN 'Piano'
  END
FROM "user" u;

-- ── Band: Os Dois Spotify ────────────────────────────────────────────────────
INSERT INTO bands (name, description)
VALUES ('Os Dois Spotify', 'Banda de dev com os usuários Spotify');

INSERT INTO band_members (band_id, user_id, role)
SELECT b.id, p.id, 'admin'  FROM bands b, profiles p
WHERE b.name = 'Os Dois Spotify' AND p.email = 'com.spotify@exemple.com';

INSERT INTO band_members (band_id, user_id, role)
SELECT b.id, p.id, 'member' FROM bands b, profiles p
WHERE b.name = 'Os Dois Spotify' AND p.email = 'sem_spotify@exemple.com';

-- ── Catalog songs ───────────────────────────────────────────────────────────
INSERT INTO songs (title, artist, standard_key) VALUES
  ('Wish You Were Here',  'Pink Floyd',   'C'),
  ('Wonderwall',          'Oasis',        'F#m'),
  ('Hotel California',    'Eagles',       'Bm'),
  ('Stairway to Heaven',  'Led Zeppelin', 'Am'),
  ('Smells Like Teen Spirit', 'Nirvana',  'Fm'),
  ('Bohemian Rhapsody',   'Queen',        'Bb');

-- ── One version per catalog song ────────────────────────────────────────────
--
-- A hold is keyed by a version since RH-124, so the seeded catalog rows need
-- one each. `migrate_catalog_to_versions()` is migration 0014's own idempotent
-- backfill, kept for exactly this: it is the single definition of what a
-- version born from a bare `songs` row looks like, so the seed and the
-- migration cannot disagree.
SELECT migrate_catalog_to_versions();

-- ── Personal repertoire: Com Spotify ────────────────────────────────────────
INSERT INTO user_songs (user_id, version_id, status)
SELECT p.id, v.id, 'learning'
FROM profiles p, songs g JOIN song_versions v ON v.song_id = g.id
WHERE p.email = 'com.spotify@exemple.com'
  AND g.title IN ('Wish You Were Here', 'Wonderwall', 'Hotel California')
ON CONFLICT DO NOTHING;

-- ── Personal repertoire: Sem Spotify ────────────────────────────────────────
INSERT INTO user_songs (user_id, version_id, status)
SELECT p.id, v.id, 'practicing'
FROM profiles p, songs g JOIN song_versions v ON v.song_id = g.id
WHERE p.email = 'sem_spotify@exemple.com'
  AND g.title IN ('Stairway to Heaven', 'Smells Like Teen Spirit')
ON CONFLICT DO NOTHING;

-- ── Band repertoire: Os Dois Spotify ────────────────────────────────────────
INSERT INTO band_songs (band_id, version_id, status)
SELECT b.id, v.id, 'polishing'
FROM bands b, songs g JOIN song_versions v ON v.song_id = g.id
WHERE b.name = 'Os Dois Spotify'
  AND g.title IN ('Bohemian Rhapsody', 'Hotel California', 'Wish You Were Here')
ON CONFLICT DO NOTHING;

-- ── Summary ──────────────────────────────────────────────────────────────────
SELECT u.email, p.full_name, p.primary_instrument, p.instruments
FROM "user" u JOIN profiles p ON p.id = u.id
ORDER BY u.email;

SELECT g.title, o.status, p.full_name AS owner
FROM user_songs o
JOIN song_versions v ON v.id = o.version_id
JOIN songs g ON g.id = v.song_id
JOIN profiles p ON p.id = o.user_id
UNION ALL
SELECT g.title, o.status, b.name AS owner
FROM band_songs o
JOIN song_versions v ON v.id = o.version_id
JOIN songs g ON g.id = v.song_id
JOIN bands b ON b.id = o.band_id
ORDER BY owner, title;

SELECT b.name AS band, bm.role, p.full_name
FROM bands b
JOIN band_members bm ON bm.band_id = b.id
JOIN profiles p ON p.id = bm.user_id
ORDER BY b.name, bm.role DESC;

SQL

# The shared catalogue lives in its own file so that first boot of the compose
# Postgres (docker/init-migrations.sh) and a host-side `npm run seed` apply exactly
# the same rows. It is ON CONFLICT DO NOTHING, so it composes with the inserts above.
echo ""
echo "🎵 Applying the song catalogue (scripts/seed-catalog.sql)..."
psql -v ON_ERROR_STOP=1 "$DB_URL" -f "$(dirname "$0")/seed-catalog.sql"

echo ""
echo "✅ Done. Password for all users: password"
